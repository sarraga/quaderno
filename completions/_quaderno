#compdef quaderno
# zsh completion for quaderno: subcommands, options, local files, and paths on the
# device (asked live from the device via `quaderno __complete`, ~0.4 s per Tab).

# Device paths; folders end in '/' and take no trailing space so Tab can descend.
# $1 = "dirs" (folders only) or "all"; options _arguments appends after it are ignored.
_quaderno_device_paths() {
  local kind=$1
  local typed=${(Q)PREFIX}
  [[ $typed == *[\*\?\[]* ]] && return 1        # a glob pattern: nothing to complete
  local -a lines dirs docs ddisp fdisp expl flag
  [[ $kind == dirs ]] && flag=(--dirs)
  # --config and --addr from the command line (captured in _quaderno) apply here too
  [[ -n $_quaderno_config ]] && flag+=(--config "$_quaderno_config")
  [[ -n $_quaderno_addr ]] && flag+=(--addr "$_quaderno_addr")
  lines=("${(@f)$(quaderno __complete $flag -- "$typed" 2>/dev/null)}")
  local l
  for l in $lines; do
    [[ -z $l ]] && continue
    if [[ $l == */ ]]; then
      dirs+=("$l"); ddisp+=("${${l%/}:t}/")
    else
      docs+=("$l"); fdisp+=("${l:t}")
    fi
  done
  local m='m:{[:lower:][:upper:]}={[:upper:][:lower:]}'   # match case-insensitively
  local ret=1
  (( $#dirs )) && _wanted device-folders expl 'device folder' \
    compadd -M "$m" -S '' -d ddisp -- "${dirs[@]}" && ret=0
  if [[ $kind != dirs ]] && (( $#docs )); then
    _wanted device-documents expl 'device document' \
      compadd -M "$m" -d fdisp -- "${docs[@]}" && ret=0
  fi
  return ret
}

_quaderno_remote() { _quaderno_device_paths all }
_quaderno_remote_dirs() { _quaderno_device_paths dirs }

_quaderno() {
  local curcontext=$curcontext state line ret=1
  typeset -A opt_args
  local -a cmds regex
  cmds=(
    'ls:list a folder'
    'get:download documents (folders with -r)'
    'put:upload PDFs (directories with -r)'
    'mkdir:create folders'
    'mv:move or rename documents/folders'
    'rm:delete documents or folders'
    'sync:mirror a device folder to the Mac'
    'open:open a document on the device screen'
    'search:find documents by name, text, or mark'
    'cp:copy documents on the device'
    'viewing:show which document is open'
    'marks:list preset annotation marks'
    'ping:verify authenticated connection'
    'replace:replace a document PDF in place'
    'annotations:download raw page annotation bytes'
    'templates:manage note templates'
    'wifi:inspect or configure Wi-Fi'
    'power:sleep, wake, reboot, or shut down'
    'firmware:precheck, upload, or apply firmware updates'
    'pen-buttons:show or assign pen button functions'
    'certs:manage CA and client certificates'
    'pastlog:download diagnostic pastlog archive'
    'config:show or change device settings'
    'time:set the device clock from the Mac'
    'info:firmware, storage, battery'
    'screenshot:save the device screen as PNG or JPEG'
    'addr:print the device address'
    'pair:pair with the device (PIN on its screen)'
  )
  regex=('(-E --regex)'{-E,--regex}'[remote paths are regular expressions]')

  _arguments -C \
    '(- *)'{-h,--help}'[show help]' \
    '--addr=[device address]:address' \
    '--config=[credentials directory]:directory:_files -/' \
    '(-v --verbose)'{-v,--verbose}'[print credentials, address, TLS mode]' \
    '1:command:->cmd' \
    '*::argument:->args' && ret=0
  # The global options, before the subcommand's own _arguments call replaces opt_args.
  local _quaderno_config=${(Q)opt_args[--config]} _quaderno_addr=${(Q)opt_args[--addr]}

  case $state in
    cmd) _describe -t commands 'quaderno command' cmds && ret=0 ;;
    args)
      curcontext=${curcontext%:*:*}:quaderno-$words[1]:
      case $words[1] in
        ls)
          _arguments $regex \
            '(-l --long)'{-l,--long}'[size, date, pages]' \
            '(-R --recursive)'{-R,--recursive}'[list subfolders too]' \
            '1::device path:_quaderno_remote' && ret=0 ;;
        get)
          _arguments $regex \
            '(-r --recursive)'{-r,--recursive}'[download folders]' \
            '(-o --output)'{-o,--output}'[local file or directory]:local path:_files' \
            '*:device path:_quaderno_remote' && ret=0 ;;
        put)
          _arguments \
            '(-r --recursive)'{-r,--recursive}'[upload directories]' \
            '(-d --dest)'{-d,--dest}'[device folder, or new name ending in .pdf]:device folder:_quaderno_remote_dirs' \
            '*:local file:_files' && ret=0 ;;
        mkdir)
          _arguments \
            '(-p --parents)'{-p,--parents}'[create missing parents]' \
            '*:device folder:_quaderno_remote_dirs' && ret=0 ;;
        mv)
          _arguments $regex '*:device path:_quaderno_remote' && ret=0 ;;
        rm)
          _arguments $regex \
            '(-r --recursive)'{-r,--recursive}'[delete folders with their contents]' \
            '(-y --yes)'{-y,--yes}'[do not ask before deleting pattern matches]' \
            '*:device path:_quaderno_remote' && ret=0 ;;
        sync)
          _arguments \
            '--delete[remove local copies of documents deleted on the device]' \
            '(-n --dry-run)'{-n,--dry-run}'[show what would happen]' \
            '--force[allow a first sync into a non-empty directory]' \
            '1:local directory:_files -/' \
            '2::device folder:_quaderno_remote_dirs' && ret=0 ;;
        open)
          _arguments $regex \
            '(-p --page)'{-p,--page}'[page number]:page' \
            '1:device document:_quaderno_remote' && ret=0 ;;
        search)
          _arguments \
            '(-t --target)'{-t,--target}'[where to search]:target:(meta body mark)' \
            '(-f --folder)'{-f,--folder}'[limit search to folder]:device folder:_quaderno_remote_dirs' \
            '(--notes --docs)--notes[only notebooks]' \
            '(--notes --docs)--docs[only documents]' \
            '--sort[order results]:field:(name title author date read size created)' \
            '--desc[descending order]' \
            '--mark[annotation kind for -t mark]:kind:(all hand highlight)' \
            '(-l --long)'{-l,--long}'[size, date, pages]' \
            '1:keyword' && ret=0 ;;
        cp)
          _arguments $regex '*:device path:_quaderno_remote' && ret=0 ;;
        replace)
          _arguments \
            '--revision=[expected file_revision guard]:revision' \
            '1:local PDF:_files -g "*.pdf"' \
            '2:device document:_quaderno_remote' && ret=0 ;;
        annotations)
          _arguments \
            '(-o --output)'{-o,--output}'[output file]:local file:_files' \
            '1:device document:_quaderno_remote' \
            '2:page number' && ret=0 ;;
        templates)
          _arguments '1:action:(ls add rename rm)' '*:argument:_files' && ret=0 ;;
        wifi)
          _arguments '1:action:(status on off scan ls add rm)' '*:argument' && ret=0 ;;
        power)
          _arguments '1:action:(sleep wake reboot shutdown)' && ret=0 ;;
        firmware)
          _arguments '1:action:(precheck upload update)' '*:argument:_files' && ret=0 ;;
        pen-buttons)
          _arguments '1:action:(ls set)' '*:argument' && ret=0 ;;
        certs)
          _arguments '1:action:(ls add-ca add-client clear)' '*:argument:_files' && ret=0 ;;
        pastlog)
          _arguments '1::output file:_files' && ret=0 ;;
        viewing|marks|ping) ret=0 ;;
        config)
          _arguments \
            '--all[print full /system/configs3 JSON]' \
            '1::setting:(owner timezone date_format time_format timeout_to_standby mtp regulation_voltage use_mode annotations_permission additional_client_registration control_servers_editable initialized_flag wifi wifi_apmode wifi_sleep_policy pen_buttons_function wifi_accesspoints)' \
            '2::value' && ret=0 ;;
        info)
          _arguments '--json[JSON output]' && ret=0 ;;
        screenshot)
          _arguments \
            '--format=[image format]:format:(png jpeg)' \
            '1::output image:_files -g "*.(png|jpg|jpeg)"' && ret=0 ;;
        pair)
          _arguments '--force[replace an existing pairing]' \
            '--pin-file[read the PIN from this file]:file:_files' && ret=0 ;;
        time|addr) ret=0 ;;
      esac ;;
  esac
  return ret
}

_quaderno "$@"
